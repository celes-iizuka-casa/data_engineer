{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-team/execution-evidence/1.0",
  "title": "Local private AI team execution evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "execution_context",
    "agents",
    "skills",
    "second_brain",
    "result",
    "quality",
    "tests",
    "human_feedback",
    "improvement_signals"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timestamp", "task_type", "request_mode"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "task_type": {"type": "string", "minLength": 1},
        "request_mode": {"type": "string", "minLength": 1}
      }
    },
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "provider", "model", "effort", "token_usage", "cost"],
      "properties": {
        "runtime": {"$ref": "#/$defs/contextString"},
        "provider": {"$ref": "#/$defs/contextString"},
        "model": {"$ref": "#/$defs/contextString"},
        "effort": {"$ref": "#/$defs/contextString"},
        "token_usage": {"$ref": "#/$defs/contextNumber"},
        "cost": {"$ref": "#/$defs/contextNumber"}
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64})$"}
        }
      }
    },
    "second_brain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "used", "source_scope"],
      "properties": {
        "available": {"type": ["boolean", "null"]},
        "used": {"type": ["boolean", "null"]},
        "source_scope": {"type": ["string", "null"]}
      },
      "oneOf": [
        {
          "properties": {
            "available": {"const": true},
            "used": {"const": true},
            "source_scope": {"type": "string", "minLength": 1}
          }
        },
        {
          "properties": {
            "available": {"type": ["boolean", "null"]},
            "used": {"const": false},
            "source_scope": {
              "oneOf": [
                {"type": "null"},
                {"type": "string", "minLength": 1}
              ]
            }
          }
        },
        {
          "properties": {
            "available": {"const": null},
            "used": {"const": null},
            "source_scope": {"const": null}
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verdict"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "verdict": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "findings", "score"],
      "properties": {
        "reviewer": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
        },
        "findings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "score": {
          "oneOf": [
            {"type": "null"},
            {"type": "number", "minimum": 0, "maximum": 4}
          ]
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executed", "passed", "evidence"],
      "properties": {
        "executed": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "passed": {"type": ["boolean", "null"]},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "human_feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present"],
      "properties": {"present": {"type": "boolean"}}
    },
    "improvement_signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strengths", "weaknesses", "repeated_mistake_candidates"],
      "properties": {
        "strengths": {
          "type": "array", "items": {"type": "string", "minLength": 1}
        },
        "weaknesses": {
          "type": "array", "items": {"type": "string", "minLength": 1}
        },
        "repeated_mistake_candidates": {
          "type": "array", "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "evidenceType": {
      "enum": ["observed", "declared", "structural", "inferred", "unavailable"]
    },
    "contextString": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "evidence_type"],
          "properties": {
            "value": {"type": "null"},
            "evidence_type": {"const": "unavailable"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "evidence_type"],
          "properties": {
            "value": {"type": "string", "minLength": 1},
            "evidence_type": {"enum": ["observed", "declared", "structural", "inferred"]}
          }
        }
      ]
    },
    "contextNumber": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "evidence_type"],
          "properties": {
            "value": {"type": "null"},
            "evidence_type": {"const": "unavailable"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "evidence_type"],
          "properties": {
            "value": {"type": "number", "minimum": 0},
            "evidence_type": {"enum": ["observed", "declared", "structural", "inferred"]}
          }
        }
      ]
    }
  }
}
