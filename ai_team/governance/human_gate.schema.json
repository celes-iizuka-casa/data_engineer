{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-team/human-gate/1.1",
  "title": "Celes human decision gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "decision_type",
    "subject_id",
    "decision",
    "decided_by",
    "timestamp",
    "independent_review_ref",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "gate_id": {"type": "string", "minLength": 1},
    "decision_type": {"enum": ["canonical_promotion", "critical_operation"]},
    "subject_id": {"type": "string", "minLength": 1},
    "subject_revision": {"type": ["string", "null"]},
    "decision": {
      "enum": ["PROMOTE", "REJECT", "REWORK", "ROLLBACK", "APPROVE", "DENY"]
    },
    "decided_by": {"const": "Celes"},
    "timestamp": {"type": "string", "format": "date-time"},
    "before_after_eval_ref": {"type": ["string", "null"]},
    "independent_review_ref": {"type": "string", "minLength": 1},
    "operation_plan_ref": {"type": ["string", "null"]},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {
        "properties": {"decision_type": {"const": "canonical_promotion"}},
        "required": ["decision_type"]
      },
      "then": {
        "required": ["subject_revision", "before_after_eval_ref"],
        "properties": {
          "subject_revision": {"type": "string", "minLength": 1},
          "before_after_eval_ref": {"type": "string", "minLength": 1},
          "decision": {"enum": ["PROMOTE", "REJECT", "REWORK", "ROLLBACK"]}
        }
      }
    },
    {
      "if": {
        "properties": {"decision_type": {"const": "critical_operation"}},
        "required": ["decision_type"]
      },
      "then": {
        "required": ["operation_plan_ref"],
        "properties": {
          "operation_plan_ref": {"type": "string", "minLength": 1},
          "decision": {"enum": ["APPROVE", "DENY", "REWORK"]}
        }
      }
    }
  ]
}
