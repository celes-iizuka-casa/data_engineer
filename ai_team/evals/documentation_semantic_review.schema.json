{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-team/documentation-semantic-review/1.0",
  "title": "Local-private documentation semantic review record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "timestamp",
    "reviewer",
    "independent",
    "trigger",
    "changed_paths",
    "review_targets",
    "dimensions",
    "findings",
    "verdict",
    "unknowns"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "review_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "reviewer": {"type": "string", "minLength": 1},
    "independent": {"const": true},
    "trigger": {
      "enum": ["changed_policy_or_workflow", "deterministic_drift_signal", "high_risk_change", "independent_reviewer_request"]
    },
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "review_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["accuracy", "completeness", "freshness", "stale_path", "contradiction", "duplication", "canonical_source_mismatch", "broken_link", "role_skill_mismatch", "stale_model_recommendation", "responsibility_clarity", "fragmentation", "cross_document_consistency", "discoverability", "ai_readability", "human_readability", "implementation_alignment", "maintainability"]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "target", "dimension", "finding", "evidence", "required_action"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["P0", "P1", "P2", "P3"]},
          "target": {"type": "string", "minLength": 1},
          "dimension": {"enum": ["accuracy", "completeness", "freshness", "stale_path", "contradiction", "duplication", "canonical_source_mismatch", "broken_link", "role_skill_mismatch", "stale_model_recommendation", "responsibility_clarity", "fragmentation", "cross_document_consistency", "discoverability", "ai_readability", "human_readability", "implementation_alignment", "maintainability"]},
          "finding": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "required_action": {"type": "string", "minLength": 1}
        }
      }
    },
    "verdict": {"enum": ["PASS", "PASS_WITH_NON_BLOCKING_FINDINGS", "REWORK_REQUIRED", "BLOCKED", "UNKNOWN"]},
    "unknowns": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"findings": {"contains": {"properties": {"severity": {"enum": ["P0", "P1"]}}, "required": ["severity"]}}}},
      "then": {"properties": {"verdict": {"enum": ["REWORK_REQUIRED", "BLOCKED"]}}}
    },
    {
      "if": {"properties": {"verdict": {"const": "PASS"}}, "required": ["verdict"]},
      "then": {"properties": {"findings": {"maxItems": 0}, "unknowns": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"verdict": {"const": "PASS_WITH_NON_BLOCKING_FINDINGS"}}, "required": ["verdict"]},
      "then": {"properties": {"findings": {"minItems": 1, "items": {"properties": {"severity": {"enum": ["P2", "P3"]}}, "required": ["severity"]}}}}
    },
    {
      "if": {"properties": {"verdict": {"const": "UNKNOWN"}}, "required": ["verdict"]},
      "then": {"properties": {"unknowns": {"minItems": 1}}}
    }
  ]
}
